{
  "manifest_version": 3,
  "name": "KICKShot",
  "version": "1.0.6",
  "description": "Compartilhamento de imagens e visualização de mídias no chat da Kick",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://kick.com/*",
    "https://catbox.moe/*",
    "https://files.catbox.moe/*",
    "https://kickshot-giphy.darkartz75.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/*"
      ],
      "js": [
        "media-codes.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
